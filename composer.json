{
    "type": "library",
    "name": "brightcreations/money-converter",
    "description": "A Laravel package for converting currencies using exchange rates.",
    "version": "v0.6.1",
    "license": "MIT",
    "authors": [
        {
            "name": "Bright Creations",
            "email": "kareem.shaaban@brightcreations.com"
        }
    ],
    "keywords": [
        "laravel",
        "exchange rates",
        "currency conversion"
    ],
    "autoload": {
        "psr-4": {
            "BrightCreations\\MoneyConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrightCreations\\MoneyConverter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BrightCreations\\MoneyConverter\\MoneyConverterServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0",
        "brick/money": "^0.10.1",
        "brick/math": "^0.12.0",
        "brightcreations/exchange-rates": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.36",
        "pestphp/pest-plugin-laravel": "^2.4",
        "orchestra/testbench": "^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    }
}
