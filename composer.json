{
    "type": "library",
    "name": "brightcreations/money-converter",
    "description": "A Laravel package for converting currencies using exchange rates.",
    "version": "v0.12.2",
    "license": "MIT",
    "authors": [
        {
            "name": "Bright Creations",
            "email": "kareem.shaaban@brightcreations.com"
        }
    ],
    "keywords": [
        "laravel",
        "exchange rates",
        "currency conversion"
    ],
    "autoload": {
        "psr-4": {
            "BrightCreations\\MoneyConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrightCreations\\MoneyConverter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BrightCreations\\MoneyConverter\\MoneyConverterServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "brick/money": "^0.10.1",
        "brick/math": "^0.12.0 || ^0.13.0 || ^0.14.0",
        "brightcreations/exchange-rates": "^0.9.0 || ^0.10.0 || ^0.11.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "vlucas/phpdotenv": "^5.6",
        "laravel/pint": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "pint": "./vendor/bin/pint"
    }
}
